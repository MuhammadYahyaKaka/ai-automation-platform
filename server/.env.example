# Server port
PORT=5000
# Secret used to sign login tokens - change this in production
JWT_SECRET=change-me-to-a-long-random-secret
# Token you invent and also paste into Meta's WhatsApp webhook setup screen
WHATSAPP_VERIFY_TOKEN=my-whatsapp-verify-token
# Optional AI keys - the platform works fully WITHOUT these via its built-in parser
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
